<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dan Wyrn: The Electromagnetic Oath</title>
  <style>
    body {
      background-color: #0b0a10;
      color: #d8d4e8;
      font-family: 'Courier New', Courier, monospace;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
      overflow: hidden;
    }
    h1 {
      color: #38bdf8;
      text-shadow: 0 0 12px #0284c7;
      margin-bottom: 5px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    p.controls {
      color: #8b85a1;
      font-size: 14px;
      margin-top: 0;
      margin-bottom: 15px;
    }
    canvas {
      background: radial-gradient(circle, #181524 0%, #07060a 100%);
      border: 2px solid #2e2942;
      box-shadow: 0 0 25px rgba(56, 189, 248, 0.2);
      cursor: crosshair;
    }
  </style>
</head>
<body>

  <h1>Dan Wyrn: Electroman</h1>
  <p class="controls"><b>WASD / Arrows:</b> Move | <b>Left-Click:</b> Electromagnetic Pulse | <b>Hold Space:</b> Magnetic Repel</p>
  <canvas id="game" width="800" height="500"></canvas>

  <script>
    const canvas = document.getElementById('game');
    const ctx = canvas.getContext('2d');

    // Game State
    let score = 0;
    let gameOver = false;
    let keys = {};
    let enemies = [];
    let bolts = [];
    let spawnTimer = 0;

    // Dan Wyrn (Player)
    const dan = {
      x: canvas.width / 2,
      y: canvas.height / 2,
      radius: 14,
      speed: 4,
      hp: 100,
      energy: 100,
      repelling: false
    };

    // Controls
    window.addEventListener('keydown', e => {
      keys[e.key.toLowerCase()] = true;
      if (e.code === 'Space') dan.repelling = true;
      if (e.key.toLowerCase() === 'r' && gameOver) resetGame();
    });
    window.addEventListener('keyup', e => {
      keys[e.key.toLowerCase()] = false;
      if (e.code === 'Space') dan.repelling = false;
    });

    // Shoot Electromagnetic Bolt on Click
    canvas.addEventListener('mousedown', e => {
      if (gameOver) return;
      const rect = canvas.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;
      const angle = Math.atan2(mouseY - dan.y, mouseX - dan.x);

      bolts.push({
        x: dan.x,
        y: dan.y,
        vx: Math.cos(angle) * 9,
        vy: Math.sin(angle) * 9,
        life: 60
      });
    });

    function spawnWraith() {
      const edge = Math.floor(Math.random() * 4);
      let x, y;
      if (edge === 0) { x = Math.random() * canvas.width; y = -20; }
      if (edge === 1) { x = canvas.width + 20; y = Math.random() * canvas.height; }
      if (edge === 2) { x = Math.random() * canvas.width; y = canvas.height + 20; }
      if (edge === 3) { x = -20; y = Math.random() * canvas.height; }

      enemies.push({
        x, y,
        radius: 15,
        speed: 1.3 + Math.random() * 1.2,
        hp: 2
      });
    }

    function resetGame() {
      dan.x = canvas.width / 2;
      dan.y = canvas.height / 2;
      dan.hp = 100;
      dan.energy = 100;
      enemies = [];
      bolts = [];
      score = 0;
      gameOver = false;
    }

    function update() {
      if (gameOver) return;

      // Move Dan Wyrn
      if ((keys['w'] || keys['arrowup']) && dan.y > dan.radius) dan.y -= dan.speed;
      if ((keys['s'] || keys['arrowdown']) && dan.y < canvas.height - dan.radius) dan.y += dan.speed;
      if ((keys['a'] || keys['arrowleft']) && dan.x > dan.radius) dan.x -= dan.speed;
      if ((keys['d'] || keys['arrowright']) && dan.x < canvas.width - dan.radius) dan.x += dan.speed;

      // Magnetic Repel Field (drains energy, pushes iron-bound wraiths back)
      if (dan.repelling && dan.energy > 0) {
        dan.energy -= 0.8;
      } else {
        dan.repelling = false;
        if (dan.energy < 100) dan.energy += 0.3;
      }

      // Update Electromagnetic Bolts
      for (let i = bolts.length - 1; i >= 0; i--) {
        let b = bolts[i];
        b.x += b.vx;
        b.y += b.vy;
        b.life--;
        if (b.life <= 0) bolts.splice(i, 1);
      }

      // Spawn Shadow-Iron Wraiths
      spawnTimer++;
      if (spawnTimer > Math.max(25, 70 - Math.floor(score / 50))) {
        spawnWraith();
        spawnTimer = 0;
      }

      // Update Enemies
      for (let i = enemies.length - 1; i >= 0; i--) {
        let e = enemies[i];
        const angle = Math.atan2(dan.y - e.y, dan.x - e.x);
        const dist = Math.hypot(dan.x - e.x, dan.y - e.y);

        // Apply Magnetic Repulsion if active and within field
        if (dan.repelling && dist < 130) {
          e.x -= Math.cos(angle) * 5;
          e.y -= Math.sin(angle) * 5;
        } else {
          e.x += Math.cos(angle) * e.speed;
          e.y += Math.sin(angle) * e.speed;
        }

        // Check Bolt Hits
        for (let j = bolts.length - 1; j >= 0; j--) {
          let b = bolts[j];
          if (Math.hypot(b.x - e.x, b.y - e.y) < e.radius + 6) {
            e.hp--;
            bolts.splice(j, 1);
            if (e.hp <= 0) {
              enemies.splice(i, 1);
              score += 10;
            }
            break;
          }
        }

        // Check Damage to Dan
        if (dist < dan.radius + e.radius) {
          dan.hp -= 0.6;
          if (dan.hp <= 0) gameOver = true;
        }
      }
    }

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Draw Magnetic Repel Aura
      if (dan.repelling) {
        ctx.beginPath();
        ctx.arc(dan.x, dan.y, 130, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(56, 189, 248, 0.6)';
        ctx.lineWidth = 3;
        ctx.stroke();
        ctx.fillStyle = 'rgba(56, 189, 248, 0.08)';
        ctx.fill();
      }

      // Draw Dan Wyrn (Cloak + Glowing Core)
      ctx.beginPath();
      ctx.arc(dan.x, dan.y, dan.radius, 0, Math.PI * 2);
      ctx.fillStyle = '#1e1b4b';
      ctx.fill();
      ctx.lineWidth = 3;
      ctx.strokeStyle = '#38bdf8';
      ctx.stroke();

      // Draw Electromagnetic Bolts
      bolts.forEach(b => {
        ctx.beginPath();
        ctx.arc(b.x, b.y, 5, 0, Math.PI * 2);
        ctx.fillStyle = '#7dd3fc';
        ctx.shadowBlur = 10;
        ctx.shadowColor = '#38bdf8';
        ctx.fill();
        ctx.shadowBlur = 0;
      });

      // Draw Shadow-Iron Wraiths
      enemies.forEach(e => {
        ctx.beginPath();
        ctx.arc(e.x, e.y, e.radius, 0, Math.PI * 2);
        ctx.fillStyle = '#3f1d38';
        ctx.fill();
        ctx.lineWidth = 2;
        ctx.strokeStyle = '#e11d48';
        ctx.stroke();
      });

      // HUD (Health, Magnetic Charge, Score)
      ctx.fillStyle = '#e2e8f0';
      ctx.font = '16px Courier New';
      ctx.fillText(`Vitality: ${Math.max(0, Math.ceil(dan.hp))}%`, 20, 30);
      ctx.fillStyle = '#38bdf8';
      ctx.fillText(`Mag-Charge: ${Math.ceil(dan.energy)}%`, 20, 52);
      ctx.fillStyle = '#facc15';
      ctx.fillText(`Souls Banished: ${score}`, canvas.width - 200, 30);

      // Game Over Screen
      if (gameOver) {
        ctx.fillStyle = 'rgba(7, 6, 10, 0.85)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#e11d48';
        ctx.font = 'bold 36px Courier New';
        ctx.fillText('DAN WYRN HAS FALLEN', canvas.width / 2 - 205, canvas.height / 2 - 10);
        ctx.fillStyle = '#d8d4e8';
        ctx.font = '18px Courier New';
        ctx.fillText('Press [R] to Reignite the Coil', canvas.width / 2 - 165, canvas.height / 2 + 30);
      }
    }

    function loop() {
      update();
      draw();
      requestAnimationFrame(loop);
    }

    loop();
  </script>
</body>
</html>
